# Copy to gatekeeper.env in this directory, fill in, then lock it down:
#   cp gatekeeper.env.example gatekeeper.env
#   chmod 600 gatekeeper.env
#
# gatekeeper.env is gitignored. No quotes around values — Docker treats them
# as part of the value.
#
# BIND_HOST / BIND_PORT are deliberately NOT here: docker-compose.yml sets them
# so a stale env file cannot break the listen address.

# The same base32 seed your Authy entry uses. PLACEHOLDER — replace it.
TOTP_SECRET=REPLACE_WITH_YOUR_BASE32_SEED

# Preferred: Tailscale OAuth client, scope auth_keys (write), owning tag:guest.
# Admin console > Settings > OAuth clients > Generate.
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=

# Fallback only if OAuth is unavailable. Long-lived and broadly scoped —
# prefer the OAuth client above and leave this blank.
TS_API_KEY=

# "-" means "the tailnet this OAuth client belongs to". Only set a real tailnet
# name if you are using TS_API_KEY instead.
TS_TAILNET=-

TS_TAG=tag:guest
KEY_TTL_SECONDS=300

ROUTE=/archie
PUBLIC_URL=https://remote.joatverse.com/archie
